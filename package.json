{
  "name": "@nszzj/dsh-scrcpy-core",
  "version": "1.0.0",
  "description": "DSH-scrcpy 共用核心 --- DSH-scrcpy Shared Core",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "client",
    "resources",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "cordis",
    "scrcpy",
    "android",
    "harmonyos"
  ],
  "license": "MIT"
}
